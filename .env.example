# Skopiuj do .env.local i uzupełnij wartościami. .env.local jest w .gitignore.

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable / anon key>
# Service-role (TAJNY — tylko serwer). Webhook Stripe zapisuje nim entitlements.
# Supabase → Settings → API → service_role. NIGDY nie wystawiaj po stronie klienta.
SUPABASE_SERVICE_ROLE_KEY=<service-role key>

# ─── AI ───────────────────────────────────────────────────────────────────────
XAI_API_KEY=<xai key>            # czat z nauczycielami (grok)
OPENAI_API_KEY=<openai key>      # embeddingi (text-embedding-3-small)

# ─── Stripe (sklep z agentami, Tydzień 4) ─────────────────────────────────────
# Tryb testowy: klucze zaczynają się od sk_test_… / whsec_…
STRIPE_SECRET_KEY=sk_test_xxx
# Sekret webhooka: lokalnie z `stripe listen`, na prod z dashboardu Stripe.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── PostHog (analityka) ──────────────────────────────────────────────────────
# eu.posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Współdzielony licznik limitów API. BEZ tych zmiennych limiter działa, ale tylko
# in-memory (per-instancja) — na Vercelu praktycznie nie egzekwuje limitu.
# Upstash → Create Database (Regional) → REST API → skopiuj URL i token.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<rest token>
